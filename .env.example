#
# Exemplo de variáveis de ambiente para o `mc-mcp-server`.
# Este arquivo pode ser versionado. NUNCA versionar `.env` com segredos reais.
#

# Opção recomendada: um único JSON com múltiplos ambientes.
# Use valores reais (sem placeholders) no seu `.env` local.
MC_ENVIRONMENTS='{"prod":{"mce":{"clientId":"SEU_CLIENT_ID_MCE","clientSecret":"SEU_CLIENT_SECRET_MCE","authBaseUri":"https://SEU_SUBDOMINIO.auth.marketingcloudapis.com/","accountId":123456789},"personalization":{"sftpHost":"sftp.SEUTENANT.personalization.salesforce.com","sftpPort":22,"sftpUser":"SEU_USUARIO_SFTP","sftpPassword":"SUA_SENHA_SFTP","remoteDir":"/Import","datasetId":"BOMBONATO-PRD"}},"stage":{"mce":{"clientId":"STAGE_CLIENT_ID","clientSecret":"STAGE_CLIENT_SECRET","authBaseUri":"https://SEU_SUBDOMINIO_STAGE.auth.marketingcloudapis.com/","accountId":"987654321"},"personalization":{"sftpHost":"sftp.STAGE.personalization.salesforce.com","sftpPort":22,"sftpUser":"STAGE_SFTP_USER","sftpPassword":"STAGE_SFTP_PASSWORD","remoteDir":"/Import","datasetId":"BOMBONATO-STG"}}}'

# Fallback (ambiente único por variáveis separadas):
# MC_DEFAULT_ENV=prod
# MCE_CLIENT_ID=SEU_CLIENT_ID_MCE
# MCE_CLIENT_SECRET=SEU_CLIENT_SECRET_MCE
# MCE_AUTH_BASE_URI=https://SEU_SUBDOMINIO.auth.marketingcloudapis.com/
# MCE_ACCOUNT_ID=123456789
# MCP_SFTP_HOST=sftp.SEUTENANT.personalization.salesforce.com
# MCP_SFTP_PORT=22
# MCP_SFTP_USER=SEU_USUARIO_SFTP
# MCP_SFTP_PASSWORD=SUA_SENHA_SFTP
# MCP_SFTP_PRIVATE_KEY_PATH=/caminho/para/chave_privada
# MCP_SFTP_REMOTE_DIR=/Import
# MCP_DATASET_ID=BOMBONATO-PRD
